{% if request.args.get('app') == 'panel' %}{
  "name": "Sellos · {{ LOYALTY.prefix }} Serena",
  "short_name": "Sellos Serena",
  "description": "Escáner de tarjetas del {{ LOYALTY.prefix }} Serena",
  "start_url": "/admin/escanear",
  "scope": "/admin",
  "display": "standalone",
  "background_color": "#2C1F19",
  "theme_color": "#2C1F19",
  "icons": [
    {"src": "{{ url_for('static', filename='icons/icon-192.png') }}", "sizes": "192x192", "type": "image/png"},
    {"src": "{{ url_for('static', filename='icons/icon-512.png') }}", "sizes": "512x512", "type": "image/png", "purpose": "any maskable"}
  ]
}{% else %}{
  "name": "Serena Nails",
  "short_name": "Serena",
  "description": "Manicura y pedicura spa en Paysandú",
  "start_url": {{ (request.referrer if request.referrer and '/tarjeta/' in request.referrer else '/') | tojson }},
  "scope": "/",
  "display": "standalone",
  "background_color": "#F5F1EA",
  "theme_color": "#4A342A",
  "icons": [
    {"src": "{{ url_for('static', filename='icons/icon-192.png') }}", "sizes": "192x192", "type": "image/png"},
    {"src": "{{ url_for('static', filename='icons/icon-512.png') }}", "sizes": "512x512", "type": "image/png", "purpose": "any maskable"}
  ]
}{% endif %}
